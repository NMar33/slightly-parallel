{
  // Editor-only config for the Node-side config files (vite/tailwind/playwright).
  // Not referenced by tsconfig.json: `tsc -b` (npm run typecheck) checks `src`
  // only — checking these files would require @types/node, which is not a
  // dependency of this package. `composite` was removed (it forced emit and
  // produced stray vite.config.js/.d.ts/.tsbuildinfo artifacts next to the
  // sources — TS6305); `noEmit` guarantees nothing is ever written.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["vite.config.ts", "tailwind.config.ts", "playwright.config.ts"]
}
