{
  // The Node-side files: the Vite, Tailwind and Playwright configs and the
  // Playwright specs (tests/). `npm run typecheck` checks them after `src`
  // (tsc -p, not -b: nothing is referenced or emitted). Before, they were
  // editor-only, and a type error in a spec showed up only when it ran.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "tailwind.config.ts", "playwright.config.ts", "playwright.fresh.config.ts", "tests"]
}
